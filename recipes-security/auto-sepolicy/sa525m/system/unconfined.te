userdebug_or_eng(`
    gen_require(`
        type unconfined_t;
        type mpss_persist_t;
    ')

    allow unconfined_t mpss_persist_t:dir { getattr open read search };
    allow unconfined_t mpss_persist_t:file { getattr read open };
')
