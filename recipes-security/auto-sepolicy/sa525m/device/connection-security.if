## <summary> connection-security </summary>

# @brief: This interface allows the domain to access to WCS access
#
# Parameters:
#   1. Domain context

interface(`access_wcs',`
    gen_require(`
        type access_wcs_t;
        type mlid_t;
        type lowi_server_t;
    ')
    allow $1 access_wcs_t:file { read open getattr};
    allow $1 self:capability setgid;
    allow $1 self:process signal;
    allow $1 lowi_server_t:unix_dgram_socket sendto;
    allow $1 mlid_t:unix_dgram_socket sendto;
')

# @brief: This interface allows the domain to access to CCS access
#
# Parameters:
#   1. Domain context

interface(`access_ccs',`
    gen_require(`
        type access_ccs_t;
    ')
    allow $1 access_ccs_t:file { read open getattr};
')