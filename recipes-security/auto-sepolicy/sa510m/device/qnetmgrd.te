gen_require(`
      type power_manager_daemon_t;
      type power_socket_t;
')

allow qnetmgrd_t power_manager_daemon_t:unix_stream_socket connectto;
allow qnetmgrd_t power_socket_t:dir search;
allow qnetmgrd_t power_socket_t:sock_file write;
