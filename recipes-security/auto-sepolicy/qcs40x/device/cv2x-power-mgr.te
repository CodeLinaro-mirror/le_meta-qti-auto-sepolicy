policy_module(cv2x-power-mgr, 1.0)
type cv2x_power_mgr_t;
type cv2x_power_mgr_exec_t;

type cv2x_power_mgr_etc_t;
files_type(cv2x_power_mgr_etc_t);

#domain transition if started from init
init_vendor_domain(cv2x_power_mgr_t, cv2x_power_mgr_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(cv2x_power_mgr_t, cv2x_power_mgr_exec_t)

# Power Client Permissions
telux_allow_power(cv2x_power_mgr_t)

gen_require(`
    type debugfs_t;
    type default_t;
    type sysfs_t;
    type init_t;
    type init_var_run_t;
    type canwrapper_data_log_t;
    type root_t;
')

manage_user_data_files(cv2x_power_mgr_t, canwrapper_data_log_t)

ifdef(`init_systemd', `
    type cv2xd_unit_t;
    gen_require(`
        class service { start status stop };
        type systemd_logind_var_run_t;
        type system_dbusd_var_run_t;
    ')
    init_unit_file(cv2xd_unit_t)
    allow cv2x_power_mgr_t cv2xd_unit_t:service { start status stop };
    allow cv2x_power_mgr_t system_dbusd_var_run_t:dir search;
    allow cv2x_power_mgr_t systemd_logind_var_run_t:sock_file write;
    init_dbus_chat(cv2x_power_mgr_t)
    systemd_dbus_chat_logind(cv2x_power_mgr_t)
    dbus_system_bus_client(cv2x_power_mgr_t)
')

#Telsdk Logging
access_telux_files(cv2x_power_mgr_t)

dev_write_kmsg(cv2x_power_mgr_t)
dev_read_input(cv2x_power_mgr_t)
dev_rw_sysfs(cv2x_power_mgr_t)

corecmd_exec_shell(cv2x_power_mgr_t)
kernel_read_system_state(cv2x_power_mgr_t)
logging_send_syslog_msg(cv2x_power_mgr_t)
allow cv2x_power_mgr_t self:process signal;
allow cv2x_power_mgr_t cv2x_power_mgr_etc_t:file { read open getattr };
allow cv2x_power_mgr_t self:capability2 block_suspend;
init_read_state(cv2x_power_mgr_t)
dontaudit cv2x_power_mgr_t default_t:dir search;
dontaudit cv2x_power_mgr_t self:capability { net_admin sys_module };
dontaudit cv2x_power_mgr_t sysfs_t:dir add_name;
dontaudit cv2x_power_mgr_t sysfs_t:file { write create };
dontaudit cv2x_power_mgr_t init_var_run_t:sock_file write;
dontaudit cv2x_power_mgr_t init_t:dir search;
dontaudit cv2x_power_mgr_t root_t:dir write;
dontaudit cv2x_power_mgr_t init_t:unix_stream_socket connectto;

userdebug_or_eng(`
    allow cv2x_power_mgr_t debugfs_t:dir search;
')
system_read_link_files(cv2x_power_mgr_t)
