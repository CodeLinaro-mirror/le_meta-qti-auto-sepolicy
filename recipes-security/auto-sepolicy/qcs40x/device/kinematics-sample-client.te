policy_module(kinematics-sample-client, 1.0)
type kinematics_sc_t;
type kinematics_sc_exec_t;

#domain transition if started from init
init_vendor_domain(kinematics_sc_t, kinematics_sc_exec_t)

transition_to_confined_domain(kinematics_sc_t, kinematics_sc_exec_t)

userdebug_or_eng(`
    kernel_search_debugfs(kinematics_sc_t);
    kernel_manage_debugfs(kinematics_sc_t);
')

gen_require(`
    type urandom_device_t;
    type unreserved_port_t;
    type etc_t;
    type tmpfs_t;
')

logging_send_syslog_msg(kinematics_sc_t)

corenet_tcp_bind_all_unreserved_ports(kinematics_sc_t)
corenet_tcp_bind_generic_node(kinematics_sc_t)
telux_allow_loc(kinematics_sc_t)
corecmd_exec_shell(kinematics_sc_t)
userdom_getattr_user_home_dirs(kinematics_sc_t)
userdom_search_user_home_dirs(kinematics_sc_t)
files_search_home(kinematics_sc_t)
kernel_read_system_state(kinematics_sc_t)
files_tmp_filetrans(kinematics_sc_t, kinematics_sc_t, { file lnk_file dir })

read_files_pattern(kinematics_sc_t, etc_t, etc_t)
read_lnk_files_pattern(kinematics_sc_t, etc_t, etc_t)

allow kinematics_sc_t tmpfs_t:filesystem { associate };
allow kinematics_sc_t self:file { create };
allow kinematics_sc_t self:capability { setgid sys_nice };
allow kinematics_sc_t self:socket { create setopt getattr read write };
allow kinematics_sc_t self:tcp_socket { create setopt connect read write };
allow kinematics_sc_t unreserved_port_t:tcp_socket { name_connect };
allow kinematics_sc_t self:process { signal setsched };
allow kinematics_sc_t urandom_device_t:chr_file { read open };
