policy_module(throttleman, 1.0)

type throttleman_t;
type throttleman_exec_t;
type throttleman_etc_t;
files_type(throttleman_etc_t);

type throttleman_socket_t;
files_type(throttleman_socket_t);
dev_node(throttleman_socket_t);
device_manage_socket_file(throttleman_t, throttleman_socket_t);

init_vendor_domain(throttleman_t, throttleman_exec_t)

gen_require(`
  type default_t;
  type ion_device_t;
')

dontaudit throttleman_t default_t:dir search;

access_telux_files(throttleman_t);
telux_allow_qmi_client(throttleman_t);

allow throttleman_t throttleman_etc_t:file { open read getattr };
logging_send_syslog_msg(throttleman_t);

allow throttleman_t throttleman_socket_t:dir { add_entry_dir_perms remove_name };
allow throttleman_t throttleman_socket_t:sock_file { read create write getattr };
rw_chr_files_pattern(throttleman_t, device_t, ion_device_t);