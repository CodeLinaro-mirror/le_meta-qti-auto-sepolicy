### power_config_service

policy_module(power_config, 1.0)

type power_config_t;
type power_config_exec_t;
files_type(power_config_exec_t)
init_script_domain(power_config_t, power_config_exec_t)

dev_rw_sysfs(power_config_t)
kernel_rw_kernel_sysctl(power_config_t)

gen_require(`
    type cpu_scaling_freq_t;
')

allow power_config_t cpu_scaling_freq_t:file { open write };
allow power_config_t proc_t:file { getattr open read };
allow power_config_t self:fifo_file { read write };
allow power_config_t sysfs_t:dir { add_name write };
allow power_config_t sysfs_t:file create;
