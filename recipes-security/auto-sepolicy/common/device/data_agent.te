policy_module(data_agent, 1.0)
type data_agent_t;
type data_agent_exec_t;

type data_agent_conf_t;
files_type(data_agent_conf_t)

#domain transition if started from init
init_vendor_domain(data_agent_t, data_agent_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(data_agent_t, data_agent_exec_t)

gen_require(`
    type net_conf_t;
    type proc_t;
    type etc_t;
    type unreserved_port_t;
    type urandom_device_t;
')

#Access data_agent configuration file
allow data_agent_t data_agent_conf_t:file { read getattr open };

#telsdk

#Telsdk Logging
access_telux_files(data_agent_t)

#Power Management services
telux_allow_power(data_agent_t)

#Allow data clients
telux_allow_data(data_agent_t)
telux_allow_data_setting(data_agent_t)
telux_allow_data_call_ops(data_agent_t)

allow data_agent_t self:process signal;
allow data_agent_t net_conf_t:file { getattr read open unlink };
allow data_agent_t self:udp_socket { read write create connect getattr };
allow data_agent_t self:netlink_route_socket { write getattr read bind create nlmsg_read };
allow data_agent_t self:tcp_socket { create_socket_perms name_connect };
allow data_agent_t unreserved_port_t:tcp_socket name_connect;
allow data_agent_t urandom_device_t:chr_file { read getattr open };

dontaudit data_agent_t proc_t:file { read getattr open };
dontaudit data_agent_t etc_t:lnk_file read;
