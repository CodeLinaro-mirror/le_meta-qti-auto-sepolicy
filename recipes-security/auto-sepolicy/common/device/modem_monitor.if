## <summary> modem_monitor </summary>

########################################
## <summary>
##    Read modem-monitor conf files in /etc.
## </summary>
## <desc>
##    <p>
##    Allow the specified domain to read modem-monitor conf
##    files in /etc. These files are modem-monitor framework
##    related system configuration files
##    </p>
## </desc>
## <param name="domain">
##    <summary>
##    Domain allowed access for modem-monitor conf files.
##    </summary>
## </param>
#
interface(`files_read_mm_etc_files',`
    gen_require(`
        type etc_t, mm_etc_t;
    ')

    list_dirs_pattern($1, etc_t, $2)
    read_files_pattern($1, etc_t, mm_etc_t)
    read_lnk_files_pattern($1, etc_t, mm_etc_t)
')

########################################
## <summary>
##      Read and write to ks bridge device node
## </summary>
## <param name="domain">
##      <summary>
##      The domain to allow access
##      </summary>
## </param>
#
interface(`ksb_rw_device',`
    gen_require(`
        type device_t;
        type ksb_device_t;
    ')

    rw_chr_files_pattern($1, device_t, ksb_device_t)
')


########################################
## <summary>
##      Read and write sockets.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
## <rolecap/>
#
interface(`mm_sendto_unix_dgram_socket',`
        gen_require(`
                type modem_monitor_t;
        ')
         allow $1 modem_monitor_t:unix_dgram_socket { sendto };
')

