interface(`connect_to_unix_loc_hald_sock',`
    gen_require(`
        type loc_hald_t;
    ')
    allow $1 loc_hald_t:unix_dgram_socket { sendto };
')

interface(`connect_loc_hald_to_unix_sock',`
    gen_require(`
        type loc_hald_t;
    ')
    allow loc_hald_t $1:unix_dgram_socket { sendto };
')
 
interface(`connect_to_unix_loc_sock',`
    gen_require(`
        type loc_t;
    ')
    allow $1 loc_t:unix_stream_socket { connectto };
')

interface(`connect_loc_to_unix_sock',`
    gen_require(`
        type loc_t;
    ')
    allow loc_t $1:unix_stream_socket { connectto };
')
