policy_module(thermal_test_app, 1.0)
type thermal_app_t;
type thermal_app_exec_t;

#domain transition if started from init
init_vendor_domain(thermal_app_t, thermal_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(thermal_app_t, thermal_app_exec_t)

#Thermal services
telux_allow_thermalmanager(thermal_app_t)

gen_require(`
        type etc_t;
')
#Allow setting secondary groups
allow thermal_app_t self:capability setgid;
allow thermal_app_t etc_t:file read_file_perms;