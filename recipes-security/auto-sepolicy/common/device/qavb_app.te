policy_module(qavb_app, 1.0)

type qavb_app_t;
type qavb_app_exec_t;

init_vendor_domain(qavb_app_t, qavb_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(qavb_app_t, qavb_app_exec_t)

gen_require(`
        type data_t;
        type tmpfs_t;
        type sysfs_t;
        type proc_net_t;
        type proc_t;
        type ptmx_t;
        type socket_device_t;
')

logging_send_syslog_msg(qavb_app_t)
allow qavb_app_t ptmx_t:chr_file rw_chr_file_perms;
# To store and play recordings in data partition
manage_user_data_files(qavb_app_t, data_t)
logging_send_syslog_msg(qavb_app_t);

gptp_rw_tmpfs_files(qavb_app_t)
allow qavb_app_t proc_net_t:file { open read getattr };
allow qavb_app_t self:process { setsched signal };
allow qavb_app_t self:tcp_socket { create ioctl };
allow qavb_app_t self:capability { sys_nice net_raw net_admin setgid setuid };
allow qavb_app_t self:packet_socket { create map bind setopt getopt read write ioctl };
allow qavb_app_t self:udp_socket { create ioctl };
allow qavb_app_t self:netlink_generic_socket { create ioctl };
rw_qipcrtr_socket(qavb_app_t);
gptp_rw_qgptp_device(qavb_app_t)
allow qavb_app_t sysfs_t:lnk_file read;
allow qavb_app_t sysfs_t:file { read open };
allow qavb_app_t tmpfs_t:dir search;
allow qavb_app_t proc_t:file read_file_perms;
allow qavb_app_t socket_device_t:dir search;
