policy_module(start_eth_pwr_m, 1.0)

type start_eth_pwr_m_t;
type start_eth_pwr_m_exec_t;
type start_eth_pwr_m_initrc_exec_t;
type start_eth_pwr_m_initrc_t;

init_vendor_domain(start_eth_pwr_m_t, start_eth_pwr_m_exec_t)
init_vendor_domain(start_eth_pwr_m_initrc_t, start_eth_pwr_m_initrc_exec_t)

gen_require(`
       type sysdevice_sysfs_t;
       type proc_t;
       type sysfs_t;
       type devlog_t;
       type power_manager_daemon_t;
       type power_socket_t;
       type socket_device_t;
       type syslogd_t;
       type shell_exec_t;
')

allow start_eth_pwr_m_t sysdevice_sysfs_t:file { getattr read open };
allow start_eth_pwr_m_initrc_t proc_t:file { getattr read open };
allow start_eth_pwr_m_initrc_t sysfs_t:file { getattr read open write };
allow start_eth_pwr_m_initrc_t start_eth_pwr_m_initrc_t:fifo_file { open read write getattr };
allow start_eth_pwr_m_initrc_t sysdevice_sysfs_t:file { getattr read open };
allow start_eth_pwr_m_initrc_t devlog_t:sock_file write;
allow start_eth_pwr_m_initrc_t power_manager_daemon_t:unix_stream_socket connectto;
allow start_eth_pwr_m_initrc_t power_socket_t:dir search;
allow start_eth_pwr_m_initrc_t power_socket_t:sock_file write;
allow start_eth_pwr_m_initrc_t socket_device_t:dir search;
allow start_eth_pwr_m_initrc_t syslogd_t:unix_dgram_socket sendto;
allow start_eth_pwr_m_initrc_t start_eth_pwr_m_exec_t:file { execute execute_no_trans map open read };
allow start_eth_pwr_m_initrc_t shell_exec_t:file { execute execute_no_trans open read };
allow start_eth_pwr_m_initrc_t sysfs_t:lnk_file read;
