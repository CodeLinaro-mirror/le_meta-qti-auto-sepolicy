policy_module(audio_talker_avb, 1.0)

type audio_talker_avb_t;
type audio_talker_avb_exec_t;

init_vendor_domain(audio_talker_avb_t, audio_talker_avb_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(audio_talker_avb_t, audio_talker_avb_exec_t)

gen_require(`
        type data_t;
        type tmpfs_t;
        type socket_device_t;
        type sysfs_t;
        type audio_hal_etc_t;
        type proc_net_t;
        type proc_t;
        type agm_server_t;
        type systemd_logind_var_run_t;
        type debugfs_t;
        type binderfs_t;
        type ptmx_t;
')

logging_send_syslog_msg(audio_talker_avb_t)
# To store and play recordings in data partition
manage_user_data_files(audio_talker_avb_t, data_t)

allow audio_talker_avb_t ptmx_t:chr_file rw_chr_file_perms;

# Gives permissions to access to hal devices such as sound devices.
auto_audio_hal_access(audio_talker_avb_t)
logging_send_syslog_msg(audio_talker_avb_t);

gptp_rw_qgptp_device(audio_talker_avb_t)
allow audio_talker_avb_t self:packet_socket { create map bind setopt getopt read write ioctl };
allow audio_talker_avb_t self:capability { sys_nice net_raw net_admin setgid setuid };
allow audio_talker_avb_t self:process { setsched signal };
allow audio_talker_avb_t socket_device_t:dir search;
allow audio_talker_avb_t audio_hal_etc_t:file read_file_perms;
rw_sound_dev_node(audio_talker_avb_t)
allow audio_talker_avb_t proc_t:file read_file_perms;
allow audio_talker_avb_t self:tcp_socket { create ioctl };
allow audio_talker_avb_t proc_net_t:file { read_file_perms };
allow audio_talker_avb_t sysfs_t:lnk_file read;
allow audio_talker_avb_t sysfs_t:file { read open };
allow audio_talker_avb_t self:fifo_file rw_fifo_file_perms;
allow audio_talker_avb_t self:udp_socket { create ioctl };
allow audio_talker_avb_t self:netlink_generic_socket { create ioctl };
rw_qipcrtr_socket(audio_talker_avb_t);
allow audio_talker_avb_t tmpfs_t:dir search;
gptp_rw_tmpfs_files(audio_talker_avb_t)
allow audio_talker_avb_t debugfs_t:dir search;
allow audio_talker_avb_t binderfs_t:dir search;

# Gives permissions for swbinders
agm_server_sw_binders_access(audio_talker_avb_t)
unconfined_allow_binder_access(audio_talker_avb_t)
#Rule to access dlt-deamon
dlt_allow_user_logging(audio_talker_avb_t)
