policy_module(power_agent, 1.0)
type power_agent_t;
type power_agent_exec_t;


#domain transition if started from init
init_vendor_domain(power_agent_t, power_agent_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(power_agent_t, power_agent_exec_t)

gen_require(`
    type net_conf_t;
    type proc_t;
    type etc_t;
    type unreserved_port_t;
    type urandom_device_t;
')

#telsdk

#Telsdk Logging
access_telux_files(power_agent_t)

#Power Management services
#Allow setting TCU activity state
telux_allow_power(power_agent_t)
telux_allow_power_control_state(power_agent_t)

#Allow SMS trigger
telux_allow_tel_sms_listen(power_agent_t)

dev_rw_sysfs(power_agent_t)
allow power_agent_t self:process signal;
allow power_agent_t self:capability2 block_suspend;
allow power_agent_t net_conf_t:file { getattr read open unlink };
allow power_agent_t self:udp_socket { read write create connect getattr setopt };
allow power_agent_t self:netlink_route_socket { write getattr read bind create nlmsg_read };
allow power_agent_t self:tcp_socket { create_socket_perms name_connect };
files_read_etc_files(power_agent_t) #/etc/nsswitch.conf
allow power_agent_t unreserved_port_t:tcp_socket name_connect;
allow power_agent_t urandom_device_t:chr_file { read getattr open };

dontaudit power_agent_t proc_t:file { read getattr open };
