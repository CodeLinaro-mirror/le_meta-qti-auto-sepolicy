policy_module(rilmuxd, 1.0)
type rilmuxd_t;
type rilmuxd_exec_t;

init_daemon_domain(rilmuxd_t, rilmuxd_exec_t)

logging_send_syslog_msg(rilmuxd_t)

type rilmuxd_tmp_t;
files_tmp_file(rilmuxd_tmp_t);
files_tmp_filetrans(rilmuxd_t, rilmuxd_tmp_t, sock_file)

allow rilmuxd_t rild_t:unix_stream_socket connectto;
allow rilmuxd_t rild_tmp_t:sock_file write;
allow rilmuxd_t rilmuxd_tmp_t:sock_file create;
allow rilmuxd_t self:unix_dgram_socket create;

permissive rilmuxd_t;
