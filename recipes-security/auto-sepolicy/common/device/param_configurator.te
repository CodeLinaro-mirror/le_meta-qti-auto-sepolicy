policy_module(param_configurator, 1.0)
type param_configurator_t;
type param_configurator_exec_t;

# domain transition if started from init
init_vendor_domain(param_configurator_t, param_configurator_exec_t)

# domain transition if started from adb shell
transition_to_confined_domain(param_configurator_t, param_configurator_exec_t)

gen_require(`
        type etc_t;
        type telsdk_etc_t;
')

# For std::cin
userdom_read_user_ptys(param_configurator_t)

# Allow setting secondary groups
telux_allow_console_apps(param_configurator_t)

# Obtain required permissions for config manager client.
telux_allow_config(param_configurator_t)

# Write onto tel.conf
allow param_configurator_t telsdk_etc_t:file write;

# Obtain required permission in terms of API access control
telux_allow_set_global_config(param_configurator_t)
telux_allow_set_local_config(param_configurator_t)
