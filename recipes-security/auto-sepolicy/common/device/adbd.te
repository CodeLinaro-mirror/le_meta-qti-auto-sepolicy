type usb_tmp_t;
files_tmp_file(usb_tmp_t);
files_tmp_filetrans(usb_t, usb_tmp_t, file, "usb_bind_in_progress")
allow usb_t usb_tmp_t:file { write getattr unlink open create };

type adb_tmp_t;
files_tmp_file(adb_tmp_t)

gen_require(`
    type systemd_tmpfiles_t;
    type tmpfs_t;
    type qmi_fw_conf_t;
    type adbd_initrc_t;
    type kmsg_device_t;
    type etc_t;
')
files_tmp_filetrans(adbd_t, adb_tmp_t, file, ".adb.root")
fs_tmpfs_filetrans(adbd_t, adb_tmp_t, file, ".adb.root")

dontaudit systemd_tmpfiles_t adb_tmp_t:file getattr;
dontaudit usb_t tmpfs_t:dir search;
allow adbd_t qmi_fw_conf_t:file { setattr write };

#============= adbd_initrc_t ==============
# kmsg_device_t is labeled at s15 getattr from this s0 domain requires MLS read clearance in addition to the TE allow rule, or it is rejected by the read-dominance constraint.
allow adbd_initrc_t kmsg_device_t:chr_file getattr;
mls_file_read_all_levels(adbd_initrc_t)

#============= usb_t ==============
allow usb_t etc_t:file { getattr read open };
allow usb_t kmsg_device_t:chr_file getattr;
mls_file_read_all_levels(usb_t)
