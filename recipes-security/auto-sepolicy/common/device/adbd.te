type usb_tmp_t;
files_tmp_file(usb_tmp_t);
files_tmp_filetrans(usb_t, usb_tmp_t, file, "usb_bind_in_progress")
allow usb_t usb_tmp_t:file { write getattr unlink open create };

type adb_tmp_t;
files_tmpfs_file(adb_tmp_t)

gen_require(`
    type systemd_tmpfiles_t;
')
files_tmp_filetrans(adbd_t, adb_tmp_t, file, ".adb.root")
dontaudit systemd_tmpfiles_t adb_tmp_t:file getattr;
