########################################
## <summary> 
## 	Given read and write permission to /persist/data.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`mgr_persist_data_path',`
    gen_require(`
        type qseecomd_persist_t;
        type persist_t;
    ')
    allow $1 qseecomd_persist_t:dir manage_dir_perms;
    filetrans_pattern($1,persist_t,qseecomd_persist_t, { file dir });
')
