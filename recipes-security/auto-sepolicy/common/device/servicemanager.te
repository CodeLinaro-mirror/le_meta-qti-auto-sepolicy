gen_require(`
    type socket_device_t;
    type servicemanager_t;
')

userdebug_or_eng(`
    gen_require(`
        type unconfined_t;
    ')
    allow servicemanager_t unconfined_t:binder transfer;
')

allow servicemanager_t socket_device_t:dir search;
