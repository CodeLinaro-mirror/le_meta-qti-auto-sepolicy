policy_module(ecall_app, 1.0)
type ecall_app_t;
type ecall_app_exec_t;

#domain transition if started from init
init_vendor_domain(ecall_app_t, ecall_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(ecall_app_t, ecall_app_exec_t)

# Telephony services
telux_allow_tel(ecall_app_t)

#Thermal Management services
telux_allow_thermalshutdown(ecall_app_t)

#Audio services
telux_allow_audio(ecall_app_t)

#Location services
telux_allow_loc(ecall_app_t)

#Allow signals to this process
allow ecall_app_t self:process signal;

gen_require(`
        type etc_t;
')
#Allow setting secondary groups
allow ecall_app_t self:capability setgid;
allow ecall_app_t etc_t:file read_file_perms;

allow ecall_app_t self:process signal;

# Provide access for necessary SDK APIs
telux_allow_tel_multisim_mgmt(ecall_app_t)
telux_allow_tel_call_info_read(ecall_app_t)
telux_allow_tel_call_mgmt(ecall_app_t)
telux_allow_tel_call_private_info(ecall_app_t)
telux_allow_tel_ecall_mgmt(ecall_app_t)

# Allowing necessary audio permissions.
telux_allow_audio_voice(ecall_app_t)

# Access for SDK APIs related to thermal shutdown management
telux_allow_therm_shutdown_ctrl(ecall_app_t)

# Access for SDK APIs related to location data
telux_allow_loc_data(ecall_app_t)