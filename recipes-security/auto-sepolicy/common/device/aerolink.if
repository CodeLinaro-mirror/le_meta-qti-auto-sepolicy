## <summary>aerolink</summary>

# @brief: This interface allows the domain to use aerolink library
# by providing necessary permissions for its operation.
#
# Parameters:
#   1) Domain context
interface(`aerolink_allow_use',`
    gen_require(`
        type qwesd_t;
        type qwes_mink_socket_t;
        type qseecom_device_t;
        type devlog_t;
        type syslogd_t;
        type ion_device_t;
        type aerolink_data_t;
        type smcinvoke_device_t;
        type cert_t;
    ')
    # manage /data/aerolink dirs
    manage_user_data_files($1, aerolink_data_t)

    # qwes permissions
    allow $1 qwesd_t:unix_stream_socket connectto;
    allow $1 qwes_mink_socket_t:sock_file write;
    allow $1 qwes_mink_socket_t:dir { getattr setattr search };
    allow $1 smcinvoke_device_t:chr_file { read write open ioctl};

    # syslog
    allow $1 devlog_t:sock_file write;
    allow $1 syslogd_t:unix_dgram_socket sendto;

    rw_chr_files_pattern($1, device_t, qseecom_device_t)

    # firmware_t:file read,open
    firmware_read_files($1)

    # ion_device_t:chr_file { read write } open,ioctl
    rw_chr_files_pattern($1, device_t, ion_device_t)
    # add permissions for keymaster
    telux_allow_crypto($1)

    allow $1 self:process signal;

    read_files_pattern($1, cert_t, cert_t)
')

# @brief: This interface allows the domain to use aerolink library to sign
# messages by providing necessary permissions for its operation.
#
# Parameters:
#   1) Domain context
interface(`aerolink_allow_sign',`
    # allow aerolink to use v2x-host driver
    v2x_host_allow_use($1)
')

# @brief: This interface allows the domain to use aerolink library
# by providing necessary permissions for its operation.
#
# Parameters:
#   1) Domain context
interface(`aerolink_allow_ipc_channel',`
    gen_require(`
        type tmpfs_t;
    ')
    allow $1 self:netlink_route_socket { create read };
    allow $1 tmpfs_t:dir { search write add_name };
    allow $1 tmpfs_t:file { create read write open lock };
    allow $1 self:capability sys_resource;
')

# @brief: This interface allows the domain to verify messages
# by providing necessary permissions for its operation.
#
# Parameters:
#   1) Domain context
interface(`aerolink_allow_verify',`
    # add pemissions for mvm
    telux_allow_sec_key_ops($1)
    telux_allow_sec_encryption_ops($1)
    telux_allow_crypto_accel($1)
    telux_allow_sec_accelerator_mgr($1)
')

