policy_module(early_settime, 1.0)

type early_settime_t;
type early_settime_exec_t;
type time_delta_t;

init_vendor_domain(early_settime_t, early_settime_exec_t)

gen_require(`
   type mount_copybind_t;
   type mount_t;
   type setfiles_t;
   type initrc_t;
   type fs_t;
')

files_type(time_delta_t)

# Bind mount the time data
mount_copybind_file(time_delta_t)

allow early_settime_t time_delta_t:file { read getattr open };
dontaudit setfiles_t time_delta_t:file { getattr};

# For systemd service to copy time data
allow initrc_t time_delta_t:file { read open };

allow time_delta_t fs_t:filesystem { associate };

