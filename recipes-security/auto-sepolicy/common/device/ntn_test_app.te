policy_module(ntn_test_app, 1.0)
type ntn_test_app_t;
type ntn_test_app_exec_t;

# domain transition if started from init
init_vendor_domain(ntn_test_app_t, ntn_test_app_exec_t)

# domain transition if started from adb shell
transition_to_confined_domain(ntn_test_app_t, ntn_test_app_exec_t)

# Allow telux files
access_telux_files(ntn_test_app_t)
telux_allow_group(ntn_test_app_t)

# Obtain required permission in terms of API access control
telux_allow_console_apps(ntn_test_app_t)
telux_allow_ntn_config(ntn_test_app_t)
telux_allow_ntn_data(ntn_test_app_t)
telux_allow_satcom(ntn_test_app_t)

#Allow location services and permissions
telux_allow_loc(ntn_test_app_t)
telux_allow_loc_data(ntn_test_app_t)
