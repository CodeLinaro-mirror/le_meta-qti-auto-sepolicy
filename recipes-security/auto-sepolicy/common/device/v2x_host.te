policy_module(v2x_host, 1.0)

type v2x_host_t;
type v2x_host_exec_t;

type v2x_host_etc_t;
files_type(v2x_host_etc_t);

type v2x_host_data_t;
files_type(v2x_host_data_t);

type v2x_host_device_t;
dev_node(v2x_host_device_t);

init_vendor_domain(v2x_host_t, v2x_host_exec_t)
transition_to_confined_domain(v2x_host_t, v2x_host_exec_t)

# use default policies for this library
v2x_host_allow_use(v2x_host_t)

