policy_module(cpu_sku_actuator, 1.0)

type cpu_sku_actuator_t;
type cpu_sku_actuator_exec_t;

init_vendor_domain(cpu_sku_actuator_t, cpu_sku_actuator_exec_t)
logging_send_syslog_msg(cpu_sku_actuator_t)

gen_require(`
       type qseecom_device_t;
       type ion_device_t;
       type kmsg_device_t;
       type socket_device_t;
       type smcinvoke_device_t;
       type vendor_dmabuf_qseecomta_heap_device_t;
       type vendor_dmabuf_qseecom_heap_device_t;
       type qvirtmgr_t;
       type tmp_t;
       type proc_t;
       type shell_exec_t;
')

#####################################################################
# Allow loading TA
#####################################################################
# allow cpu_sku_actuator to access /dev/qseecom
rw_chr_files_pattern(cpu_sku_actuator_t, device_t, qseecom_device_t);
rw_chr_files_pattern(cpu_sku_actuator_t, device_t, ion_device_t);

# allow cpu_sku_actuator to read /firmware/image/softsku.mbn TA file
firmware_read_files(cpu_sku_actuator_t);

# For using QWES framework
write_qwes_mink_sock(cpu_sku_actuator_t)

# allow cpu_sku_actuator to read /dev/smcinvoke file
rw_chr_files_pattern(cpu_sku_actuator_t, device_t, smcinvoke_device_t);

allow cpu_sku_actuator_t socket_device_t:dir search;

# allow qwesd to access /dev/dma_heap/qcom,qseecom-ta
rw_chr_files_pattern(cpu_sku_actuator_t, device_t, vendor_dmabuf_qseecomta_heap_device_t);
rw_chr_files_pattern(cpu_sku_actuator_t, device_t, vendor_dmabuf_qseecom_heap_device_t);

#####################################################################
# Allow access to /sys nodes
#####################################################################
allow cpu_sku_actuator_t sysfs_t:dir read;
dev_rw_sysfs(cpu_sku_actuator_t)

#####################################################################
# Allow access to kmsg
#####################################################################
dev_write_kmsg(cpu_sku_actuator_t)
mls_file_write_all_levels(cpu_sku_actuator_t)

#####################################################################
# Allow wake and block_suspend
#####################################################################
allow cpu_sku_actuator_t self:capability2 { wake_alarm block_suspend };

#####################################################################
# Allow reboot
#####################################################################
allow cpu_sku_actuator_t self:capability { sys_boot kill };

qvirtmgr_tmp_file(cpu_sku_actuator_t);
allow cpu_sku_actuator_t tmp_t:dir { search };
allow cpu_sku_actuator_t tmp_t:file { open read };
allow cpu_sku_actuator_t qvirtmgr_t:process { signal };
allow cpu_sku_actuator_t self:fifo_file { read getattr };
allow cpu_sku_actuator_t shell_exec_t:file { read open execute execute_no_trans };
allow cpu_sku_actuator_t proc_t:file { read  open };
allow cpu_sku_actuator_t self:process signal;

#####################################################################
# Allow to use dlt logging
#####################################################################
dlt_allow_user_logging(cpu_sku_actuator_t);
