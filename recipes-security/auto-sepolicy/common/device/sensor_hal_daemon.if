## <summary>Sensot Hal Daemon</summary>

interface(`sensor_dev_socket',`
   gen_require(`
        type sensor_hal_daemon_socket_t;
        type socket_device_t;
        type power_manager_daemon_t;
        type power_socket_t;
	type sensor_util_t;
	type system_data_t;
	attribute sensor_util_rw_t;
	type user_home_dir_t;
    ')
allow $1 user_home_dir_t:dir search;
allow $1 system_data_t:dir { search getattr read };
allow $1 sensor_util_t:file { read getattr open };
allow $1 sensor_hal_daemon_socket_t:dir { read getattr open };
allow $1 socket_device_t:dir search;
allow $1 sensor_hal_daemon_socket_t:dir { write search add_name remove_name };
allow $1 sensor_hal_daemon_socket_t:sock_file { create setattr unlink };
allow $1 sensor_hal_daemon_socket_t:sock_file write;
allow sensor_hal_daemon_t power_manager_daemon_t:unix_stream_socket connectto;
allow sensor_hal_daemon_t power_socket_t:sock_file write;
allow sensor_hal_daemon_t power_socket_t:dir search;
logging_send_syslog_msg(sensor_hal_daemon_t)
')

interface(`sensor_configuration_access',`
    gen_require(`
        type sensor_hal_daemon_conf_t;
        type sensor_hal_daemon_t;
        type sensor_hal_daemon_exec_t;
    ')
allow $1 sensor_hal_daemon_conf_t:file { read getattr open };
allow $1 sensor_hal_daemon_t:unix_dgram_socket sendto;
allow sensor_hal_daemon_t $1:unix_dgram_socket sendto;
allow $1 self:capability { chown };
')
