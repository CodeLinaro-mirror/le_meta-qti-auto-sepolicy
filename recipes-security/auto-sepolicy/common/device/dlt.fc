# Executable file context
/usr/bin/dlt-system           --      gen_context(system_u:object_r:dlt_exec_t,s0)
/usr/bin/dlt-logd-converter   --      gen_context(system_u:object_r:dlt_exec_t,s0)
/usr/bin/dlt-daemon           --      gen_context(system_u:object_r:dlt_exec_t,s0)

# Config file context
/etc/dlt_gateway.conf         --      gen_context(system_u:object_r:dlt_etc_t,s0)
/etc/dlt.conf                 --      gen_context(system_u:object_r:dlt_etc_t,s0)
/etc/dlt-logd-converter.conf  --      gen_context(system_u:object_r:dlt_etc_t,s0)
/etc/dlt-system.conf          --      gen_context(system_u:object_r:dlt_etc_t,s0)
/etc/dlt-log-levels.conf      --      gen_context(system_u:object_r:dlt_etc_t,s0)
/etc/dlt_logstorage.conf      --      gen_context(system_u:object_r:dlt_etc_t,s0)
/dev/mqueue/dlt_message_queue.*  --      gen_context(system_u:object_r:dlt_shm_t,s0)
/tmp/dltlogs(/.*)?      gen_context(system_u:object_r:dlt_logstorage_t,s0)
/data/dltlogs(/.*)?                 gen_context(system_u:object_r:dlt_logstorage_data_t,s0)
