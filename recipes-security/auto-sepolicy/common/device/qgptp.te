policy_module(qgptp, 1.0)

type qgptp_t;
type qgptp_exec_t;

init_vendor_domain(qgptp_t, qgptp_exec_t)
#domain transition if started from adb shell
transition_to_confined_domain(qgptp_t, qgptp_exec_t)

gen_require(`
	type tmpfs_t;
	type socket_device_t;
	type etc_t;
	type event_device_t;
')

type qgptp_device_t;
type gptp_socket_t;
dev_node(qgptp_device_t)
files_type(gptp_socket_t)
dev_node(gptp_socket_t)
type gptp_tmpfs_t;
files_tmp_file(gptp_tmpfs_t);
fs_tmpfs_filetrans(qgptp_t, gptp_tmpfs_t, file)
logging_send_syslog_msg(qgptp_t)

userdebug_or_eng(`
	gen_require(`
	    type unconfined_t;
   ')
    allow unconfined_t gptp_tmpfs_t:file { getattr rw_file_perms };
')

allow qgptp_t etc_t:file read_file_perms;
allow qgptp_t self:capability { net_raw net_admin chown };
allow qgptp_t self:netlink_route_socket { read bind create };
allow qgptp_t self:packet_socket create_socket_perms;
allow qgptp_t self:tcp_socket { create ioctl };
allow qgptp_t self:unix_stream_socket { listen };
allow qgptp_t tmpfs_t:filesystem getattr;
allow qgptp_t gptp_tmpfs_t:file manage_file_perms;
allow qgptp_t gptp_tmpfs_t:file { getattr rw_file_perms map };
allow qgptp_t qgptp_device_t:chr_file { rw_chr_file_perms setattr };
allow qgptp_t event_device_t:chr_file { ioctl open read write };
allow qgptp_t socket_device_t:dir search;
allow qgptp_t gptp_socket_t:dir rw_dir_perms;
allow qgptp_t gptp_socket_t:sock_file { create unlink };
