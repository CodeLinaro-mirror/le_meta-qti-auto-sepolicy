/usr/bin/modem-monitor       --  gen_context(system_u:object_r:modem_monitor_exec_t,s0)
/usr/bin/SSR_CLI       --  gen_context(system_u:object_r:modem_monitor_exec_t,s0)
/usr/bin/modem-monitor-compression\.sh               --  gen_context(system_u:object_r:modem_monitor_compression_exec_t,s0)
/usr/bin/modem-monitor-ramdump\.sh               --  gen_context(system_u:object_r:modem_monitor_ramdump_exec_t,s0)
/usr/bin/modem-monitor-init\.sh               --  gen_context(system_u:object_r:modem_monitor_init_exec_t,s0)
/data/mdm_dumps(/.*)?                gen_context(system_u:object_r:mm_data_t,s0)

/etc/modem-monitor-usb.conf       -- gen_context(system_u:object_r:mm_etc_t,s0)
/etc/modem-monitor-pcie.conf       -- gen_context(system_u:object_r:mm_etc_t,s0)
/etc/modem-monitor-eth.conf       -- gen_context(system_u:object_r:mm_etc_t,s0)

#ks app
/usr/bin/ks          --    gen_context(system_u:object_r:ks_exec_t,s0)
/dev/ks_usb_bridge.0               -c  gen_context(system_u:object_r:ksb_device_t,s0)

/dev/rmt_sys_evt    -c    gen_context(system_u:object_r:rmt_sys_evt_device_t,s0)
