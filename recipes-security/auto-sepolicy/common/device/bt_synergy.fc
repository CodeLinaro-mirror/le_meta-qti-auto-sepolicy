/usr/bin/csr_bt_app_default_hci   --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)
/usr/bin/bt_audio_service         --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)
/usr/bin/bt_bootstrap             --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)
/usr/bin/btdiag                   --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)
/usr/bin/bt_test                  --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)
/usr/bin/synergy.sh               --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)
/usr/bin/bt_test.sh               --  gen_context(system_u:object_r:bt_synergy_exec_t,s0)

/data/bt(/.*)?                        gen_context(system_u:object_r:bt_synergy_data_t,s0)

/dev/socket/ConnxSocketBtAudioService-SynergyService -s gen_context(system_u:object_r:bt_synergy_socket_t,s0)

/tmp/bt.log                      --  gen_context(system_u:object_r:bt_synergy_tmp_t,s0)
/tmp/bt_bootstrap.log            --  gen_context(system_u:object_r:bt_synergy_tmp_t,s0)
/tmp/hci_bootstrap.cfa           --  gen_context(system_u:object_r:bt_synergy_tmp_t,s0)
/tmp/btdiag.log                  --  gen_context(system_u:object_r:bt_synergy_tmp_t,s0)
