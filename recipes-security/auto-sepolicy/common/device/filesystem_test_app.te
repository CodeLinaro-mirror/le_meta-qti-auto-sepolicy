policy_module(filesystem_test_app, 1.0)
type filesystem_test_app_t;
type filesystem_test_app_exec_t;

#domain transition if started from init
init_vendor_domain(filesystem_test_app_t, filesystem_test_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(filesystem_test_app_t, filesystem_test_app_exec_t)

gen_require(`
        type user_devpts_t;
        type etc_t;
')

# For std::cin
allow filesystem_test_app_t user_devpts_t:chr_file read;

#Allow setting secondary groups
allow filesystem_test_app_t self:capability setgid;

# Obtain required permissions from telux_allow_platform
telux_allow_platform(filesystem_test_app_t)

# Obtain required permission in terms of API access control
telux_allow_platform_listen_efs_events(filesystem_test_app_t)
telux_allow_platform_efs_ops_ctrl(filesystem_test_app_t)
telux_allow_platform_ota_mgmt(filesystem_test_app_t)
