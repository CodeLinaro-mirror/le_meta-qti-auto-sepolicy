/etc/init.qti.debug.sh    --  gen_context(system_u:object_r:init_qti_etc_t,s0)
/dev/dma_heap/qcom,qseecom-ta -c gen_context(system_u:object_r:vendor_dmabuf_qseecomta_heap_device_t,s0)

/dev/mtdblock[0-9]+     -b   gen_context(system_u:object_r:mtd_block_t,s0)

/dev/ubiblock0_[0-9]+   -b   gen_context(system_u:object_r:ubiblock_device_t,s0)

/dev/mmcblk0p[0-9]+     -b   gen_context(system_u:object_r:mmcblock_device_t,s0)

# add context for  dm mapper nodes
/dev/mapper/rootfs      -b   gen_context(system_u:object_r:dm_device_t,s0)
/dev/mapper/telaf      -b   gen_context(system_u:object_r:dm_device_t,s0)
/dev/mapper/vm-bootsys      -b   gen_context(system_u:object_r:dm_device_t,s0)
/dev/mapper/lxcrootfs      -b   gen_context(system_u:object_r:dm_device_t,s0)

# add context for qmi_fw.conf file and vendor folder ###
/vendor(/.*)?                  gen_context(system_u:object_r:vendor_t,s0)
/vendor/etc/qmi_fw.conf   --   gen_context(system_u:object_r:qmi_fw_conf_t,s0)
