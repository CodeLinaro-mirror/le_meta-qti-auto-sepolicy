policy_module(location_test_app, 1.0)
type location_test_app_t;
type location_test_app_exec_t;
type rtcm_conf_t;
files_type(rtcm_conf_t)

#domain transition if started from init
init_vendor_domain(location_test_app_t, location_test_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(location_test_app_t, location_test_app_exec_t)

#Location services
telux_allow_loc(location_test_app_t)

gen_require(`
        type etc_t;
        type user_home_dir_t;
        type sysctl_t;
        type commplex_main_port_t;
        type mount_copybind_t;
        type mount_t;
        type mxi_port_t;
        type ptmx_t;
        type xen_port_t;
        type unreserved_port_t;
')

#Allow setting secondary groups
allow location_test_app_t self:capability setgid;
allow location_test_app_t self:process signal;
allow location_test_app_t etc_t:file read_file_perms;

# allow read access to location config files
allow location_test_app_t rtcm_conf_t:file read_file_perms;
allow location_test_app_t user_home_dir_t:dir search;
allow location_test_app_t user_home_dir_t:file { read open };

# allow access to perform socket operations
allow location_test_app_t self:tcp_socket { create_socket_perms listen bind accept read write connect shutdown getopt setopt};
allow location_test_app_t self:socket {create_socket_perms read write setopt getattr};
allow location_test_app_t self:udp_socket { create setopt connect write getattr read };

# allow connections to multiple ports
allow location_test_app_t commplex_main_port_t:tcp_socket name_connect;
allow location_test_app_t mxi_port_t:tcp_socket name_connect;
allow location_test_app_t xen_port_t:tcp_socket name_connect;
allow location_test_app_t unreserved_port_t:tcp_socket name_connect;

# read /etc/resolv.conf symlink
allow location_test_app_t etc_t:lnk_file read_lnk_file_perms;

# Bind-mount and manage RTCM config file
allow mount_copybind_t rtcm_conf_t:file { setattr getattr read open relabelto create write };
allow mount_t rtcm_conf_t:file { getattr mounton };

# Suppress ioctl audit for mount_copybind on rtcm_conf
dontaudit mount_copybind_t rtcm_conf_t:file { ioctl };

# Suppress noisy sysctl (/proc/sys) dir search AVC
dontaudit location_test_app_t sysctl_t:dir search;

#Allow Location permissions.
telux_allow_loc_data(location_test_app_t)
telux_allow_loc_config(location_test_app_t)
telux_allow_loc_consent(location_test_app_t)

# Allow PTY device access (e.g., /dev/ptmx)
rw_chr_files_pattern(location_test_app_t, device_t, ptmx_t);

# DNS resolver config and UDP DNS queries
sysnet_manage_config(location_test_app_t)
sysnet_dns_name_resolve(location_test_app_t)
