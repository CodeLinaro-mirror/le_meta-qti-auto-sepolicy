policy_module(bt_synergy, 1.0)
type bt_synergy_t;
type bt_synergy_exec_t;
type bt_synergy_data_t;
type bt_synergy_socket_t;
type bt_synergy_tmp_t;

init_vendor_domain(bt_synergy_t, bt_synergy_exec_t)
transition_to_confined_domain(bt_synergy_t, bt_synergy_exec_t)

gen_require(`
      type default_t;
      type socket_device_t;
      type data_t;
      type firmware_t;
      type bluetooth_conf_t;
      type sysfs_t;
      type tmp_t;
      type tmpfs_t;
      type dlt_tmp_t;
      type dlt_t;
      type devlog_t;
      type syslogd_t;
      type home_root_t;
      type user_home_dir_t;
      type proc_t;
      type shell_exec_t;
      type tty_device_t;
      type unreserved_port_t;
      type node_t;
      type sysctl_t;
      type telsdk_data_t;
      type telsdk_etc_t;
      type telux_access_audio_play_t;
      type telux_access_audio_capture_t;
      type telux_access_tel_call_info_read_t;
      type telux_access_tel_call_mgmt_t;
      type telux_access_tel_call_private_info_t;
      type telux_access_tel_private_info_read_t;
      type telux_access_audio_voice_t;
')

# Allow BT apps create socket file for IPC as the server
dev_node(bt_synergy_socket_t)
device_manage_socket_file(bt_synergy_t, bt_synergy_socket_t)
device_search_sockets(bt_synergy_socket_t)

# Allow BT apps access to bt_synergy_data_t under /data/
user_data_files_type(bt_synergy_data_t)
allow bt_synergy_t bt_synergy_data_t:dir { search write add_name remove_name create getattr read };
data_filetrans(bt_synergy_t, bt_synergy_data_t, { file dir })
manage_user_data_files(bt_synergy_t, bt_synergy_data_t)
rw_files_pattern(bt_synergy_t, bt_synergy_data_t, bt_synergy_data_t)

# Allow BT apps access to BT firmware files
allow bt_synergy_t firmware_t:dir search;
allow bt_synergy_t firmware_t:file { read getattr open };

# Allow BT apps access to directory and files under /etc/bluetooth
allow bt_synergy_t bluetooth_conf_t:dir search;
allow bt_synergy_t bluetooth_conf_t:file { open write create read getattr };

# csr_bt_app_default_hci and bt_audio_service ipc through socket
rw_shutdown_qipcrtr_socket(bt_synergy_t);
allow bt_synergy_t self:socket { write read getattr create setopt setattr };

# Allow BT apps socket connect for IPC
allow bt_synergy_t self:unix_stream_socket connectto;

# Allow telsdk lib linked to BT apps access to /data/vendor/telsdk/tel.log in running time
allow bt_synergy_t telsdk_data_t:file { append open getattr read write };

# Allow telsdk lib linked to BT apps access to /etc/tel.conf in running time
allow bt_synergy_t telsdk_etc_t:file { read open };

# Allow BT apps access /sys/class/tty/ttyHS0/device/hs_uart_operation for uart issue when multiplibs
allow bt_synergy_t sysfs_t:lnk_file read;
allow bt_synergy_t sysfs_t:file { create getattr open read write };

# Allow BT apps create/access logs under /tmp
files_tmp_filetrans(bt_synergy_t, bt_synergy_tmp_t, { file dir });
manage_files_pattern(bt_synergy_t, tmp_t, bt_synergy_tmp_t);
allow bt_synergy_tmp_t tmpfs_t:filesystem associate;

# Allow rm/cat command access to bt_synergy_tmp_t in the Synergy.sh when do FTM test
userdebug_or_eng(`
allow unconfined_t bt_synergy_tmp_t:file { getattr read open write unlink };
')

# Allow BT apps to access dlt related
allow bt_synergy_t dlt_tmp_t:sock_file write ;
allow bt_synergy_t dlt_t:unix_stream_socket connectto;

# Allow sh to launch the BT apps by executing the shell script
allow bt_synergy_t shell_exec_t:file { execute execute_no_trans open read };

userdebug_or_eng(`
allow unconfined_t bt_synergy_exec_t:file { execute read getattr };
')
allow bt_synergy_t bt_synergy_exec_t:file entrypoint;

# Allow writing to the Kernel message log related to UART
logging_send_syslog_msg(bt_synergy_t)

# Allow BT apps access to UART device (/dev/ttyHSX) for BT HCI transport
allow bt_synergy_t tty_device_t:chr_file manage_chr_file_perms;

# Allow BT app uses the "system(clear)" for clearing current console display
allow bt_synergy_t proc_t:file { open read getattr };

# Ignore
dontaudit bt_synergy_t home_root_t:dir search;

# Ignore
# BT app is a console UI application. It will clear the display by calling
# system(clear). So the clear binary in $PATH will be checked. The /legato/systems/current/bin
# is added from one time. So the dir permission for telaf_fw_t domain is needed.
# Because the /usr/bin/clear is expected for this case, so can ignore this aduit error.
ifdef(`qti-nad-telaf',`
     gen_require(`
         type telaf_fw_t;
     ')
     dontaudit bt_synergy_t telaf_fw_t:dir search;
')

# Ignore
# This error reported when BT app exits, but don't find the reason from code of BT app perspective
# from strace log. And don't find anything function affected. So added below rule.
dontaudit bt_synergy_t sysctl_t:dir search;

# Allow BT application access play/capture device provided by telsdk for BT HFP audio and A2DP SINK audio
allow bt_synergy_t telux_access_audio_play_t:file { getattr };
allow bt_synergy_t telux_access_audio_capture_t:file { getattr };

# Allow BT application access telux_access_XXX_t for BT HFG call and audio
allow bt_synergy_t telux_access_tel_call_info_read_t:file { getattr };
allow bt_synergy_t telux_access_tel_call_mgmt_t:file { getattr };
allow bt_synergy_t telux_access_tel_call_private_info_t:file { getattr };
allow bt_synergy_t telux_access_audio_voice_t:file { getattr };

# Allow BT application access tel_private_info_read_t, this permission request happens during audio SSR
allow bt_synergy_t telux_access_tel_private_info_read_t:file { getattr };

# Allow BT FTM tool create socket and accept QRCT/QPSR TCP connction from remote IP device
allow bt_synergy_t self:tcp_socket { create_socket_perms name_bind listen accept };
allow bt_synergy_t unreserved_port_t:tcp_socket { name_bind };
allow bt_synergy_t node_t:tcp_socket { node_bind };

# Others
allow bt_synergy_t user_home_dir_t:dir search;
allow bt_synergy_t self:fifo_file rw_fifo_file_perms;
allow bt_synergy_t self:process signal;

# Allow BT application calls setgroups() to add supplementary groups
allow bt_synergy_t self:capability setgid;
