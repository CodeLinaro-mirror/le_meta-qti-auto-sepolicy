policy_module(ssgtzd, 1.0)

type ssgtzd_t;
type ssgtzd_exec_t;
type ssgtzd_etc_ta_config_t;

init_vendor_domain(ssgtzd_t, ssgtzd_exec_t)

gen_require(`
        type devlog_t;
        type syslogd_t;
        type smcinvoke_device_t;
        type unconfined_t;
        type socket_device_t;
        class service { start status };
')
#============= ssgtzd_t ==============
allow ssgtzd_t devlog_t:sock_file write;
allow ssgtzd_t self:fifo_file write;
allow ssgtzd_t self:process signal;
allow ssgtzd_t self:qipcrtr_socket { create getattr setopt shutdown write read };
#!!!! This avc can be allowed using the boolean 'nscd_use_shm'
allow ssgtzd_t self:unix_stream_socket { accept listen };
allow ssgtzd_t smcinvoke_device_t:chr_file { ioctl open read write };
allow ssgtzd_t socket_device_t:dir { add_name remove_name search write };
allow ssgtzd_t socket_device_t:sock_file { create unlink setattr};
allow ssgtzd_t syslogd_t:unix_dgram_socket sendto;
allow ssgtzd_t ssgtzd_etc_ta_config_t:dir { open getattr search read };
allow ssgtzd_t ssgtzd_etc_ta_config_t:file { read getattr open };
#============= unconfined_t ==============
allow unconfined_t ssgtzd_exec_t:service { start status };
allow unconfined_t ssgtzd_etc_ta_config_t:dir { open getattr search read };
allow unconfined_t ssgtzd_etc_ta_config_t:file { read getattr open };
