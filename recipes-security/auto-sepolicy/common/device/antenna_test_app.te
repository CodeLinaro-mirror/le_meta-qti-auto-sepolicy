policy_module(antenna_test_app, 1.0)
type antenna_test_app_t;
type antenna_test_app_exec_t;

#domain transition if started from init
init_vendor_domain(antenna_test_app_t, antenna_test_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(antenna_test_app_t, antenna_test_app_exec_t)
telux_allow_console_apps(antenna_test_app_t)

#Allow setting secondary groups
allow antenna_test_app_t self:capability setgid;

# Obtain required permissions from telux_allow_platform
telux_allow_platform(antenna_test_app_t)

# Obtain required permission in terms of API access control
telux_allow_platform_antenna_mgmt(antenna_test_app_t)

# Allow signals to this process
allow antenna_test_app_t self:process signal;