## Automotive specific sepolicy rules for location.

##### location hal daemon

gen_require(`
    type power_manager_daemon_t;
    type power_socket_t;
    type location_test_app_t;
    type loc_socket_t;
    type node_t;
    type ecall_app_t;
    type sensor_hal_daemon_conf_t;
    type sensor_util_t;
    type qmux_radio_sock_t;
    type telsdk_etc_t;
    type telsdk_data_t;
    type unreserved_port_t;
    type power_socket_t;
    type power_manager_daemon_t;
    type sensor_hal_daemon_tmp_t;
    type sensor_hal_daemon_t;
    type ssgtzd_t;
    type ssgtzd_sock_t;
')

type loc_idl_service_exec_t;

userdebug_or_eng(`
    gen_require(`
        type unconfined_t;
    ')
    connect_loc_hald_to_unix_sock(unconfined_t)
    connect_loc_to_unix_sock(unconfined_t)
    allow unconfined_t loc_idl_service_exec_t:file { execute execute_no_trans getattr map open read };
')

# power manager access
stream_connect_pattern(loc_hald_t,power_socket_t,power_socket_t,power_manager_daemon_t);

# Telsdk location access
dgram_send_pattern(loc_hald_t, loc_socket_t, loc_socket_t, location_test_app_t);

# Ecall app access
dgram_send_pattern(loc_hald_t, loc_socket_t, loc_socket_t, ecall_app_t);

#### loc hal daemon ####
gptp_rw_gptp_sock_file(loc_hald_t);
gptp_rw_qgptp_device(loc_hald_t);
gptp_rw_tmpfs_files(loc_hald_t);
read_files_pattern(loc_hald_t, systemd_resolved_var_run_t, systemd_resolved_var_run_t)
connect_loc_hald_to_unix_sock(slim_daemon_t)
connect_to_unix_loc_hald_sock(slim_daemon_t)
write_qwes_mink_sock(loc_hald_t)
connect_loc_hald_to_unix_sock(xtwifi_client_t)
connect_to_unix_loc_hald_sock(xtwifi_client_t)
allow loc_hald_t ssgtzd_t:unix_stream_socket connectto;
allow loc_hald_t ssgtzd_sock_t:sock_file write;
allow loc_hald_t tmp_t:dir search;

#### xtwifi_client_t ####
allow xtwifi_client_t xtwifi_agent_t:unix_dgram_socket sendto;

#### xtwifi_agent_t ####
connect_to_unix_loc_hald_sock(xtwifi_agent_t)
allow xtwifi_agent_t xtwifi_client_t:unix_dgram_socket sendto;
allow { xtwifi_client_t xtwifi_agent_t } loc_t:unix_dgram_socket { read write sendto };

#### engine service #####
corenet_tcp_connect_soundd_port(engine_service_t);
corenet_tcp_connect_xen_port(engine_service_t);
corenet_tcp_connect_http_port(engine_service_t);
miscfiles_read_generic_certs(engine_service_t);
write_qwes_mink_sock(engine_service_t)
rw_qipcrtr_socket(engine_service_t);
allow engine_service_t loc_t:unix_dgram_socket { read write sendto };
allow engine_service_t self:process signal;

#### slim_daemon ####
allow slim_daemon_t self:udp_socket create_socket_perms;
allow slim_daemon_t unreserved_port_t:udp_socket name_bind;
allow slim_daemon_t node_t:udp_socket node_bind;
allow slim_daemon_t systemd_resolved_var_run_t:dir search;
allow slim_daemon_t tmpfs_t:filesystem getattr;
allow slim_daemon_t tmpfs_t:dir search;
allow slim_daemon_t self:can_socket create;
allow slim_daemon_t self:can_socket { bind ioctl read setopt };
allow slim_daemon_t sensor_util_t:file { getattr open read };
allow slim_daemon_t system_data_t:dir { getattr read };
allow slim_daemon_t system_data_t:dir search;
dontaudit slim_daemon_t self:capability net_admin;
sensor_dev_socket(slim_daemon_t)
sensor_configuration_access(slim_daemon_t)
allow slim_daemon_t lowi_server_t:unix_dgram_socket sendto;
allow slim_daemon_t device_t:dir search;
leprop_rw_props(slim_daemon_t);

#### edgnss_daemon ####
allow edgnss_daemon_t ssgtzd_t:unix_stream_socket connectto;
allow edgnss_daemon_t ssgtzd_sock_t:sock_file write;
allow edgnss_daemon_t qwes_mink_socket_t:dir search;
allow edgnss_daemon_t qwes_mink_socket_t:sock_file write;
allow edgnss_daemon_t qwesd_t:unix_stream_socket connectto;
allow edgnss_daemon_t unreserved_port_t:tcp_socket name_connect;

# IPC router
allow slim_daemon_t self:qipcrtr_socket create_socket_perms;
read_files_pattern(slim_daemon_t, systemd_resolved_var_run_t, systemd_resolved_var_run_t)
dev_read_urand(slim_daemon_t);
gptp_rw_gptp_sock_file(slim_daemon_t);
gptp_rw_qgptp_device(slim_daemon_t);
gptp_rw_tmpfs_files(slim_daemon_t);

#### add telux related services for loc_t and xtra-daemon####
sysnet_manage_config(loc_t)
sysnet_dns_name_resolve(loc_t)

corenet_tcp_bind_generic_node(loc_t)
corenet_udp_bind_generic_node(loc_t)
corenet_tcp_connect_http_port(loc_t)
corenet_tcp_bind_generic_node(xtra_daemon_t)
corenet_udp_bind_generic_node(xtra_daemon_t)

read_files_pattern(loc_t, default_t, default_t);
read_files_pattern(loc_t, systemd_resolved_var_run_t, systemd_resolved_var_run_t)
read_files_pattern(loc_t, cert_t, cert_t)

# read build.prop
leprop_read_props(loc_t)

allow loc_t cert_t:lnk_file read_lnk_file_perms;
telux_allow_data(loc_t)
telux_allow_data(xtra_daemon_t)
telux_allow_data(edgnss_daemon_t)
telux_allow_tel(loc_t)
telux_allow_tel(xtra_daemon_t)
telux_allow_tel(edgnss_daemon_t)
telux_allow_data_call_ops(xtra_daemon_t)
telux_allow_data_call_ops(edgnss_daemon_t)
telux_allow_tel_private_info_read(xtra_daemon_t)
telux_allow_tel_private_info_read(edgnss_daemon_t)
gptp_rw_gptp_sock_file(loc_t)
gptp_rw_tmpfs_files(loc_t)
gptp_rw_qgptp_device(loc_t)
userdom_wo_user_tmp_sockets(loc_t)
#address someip realted denials from /tmp
files_tmp_filetrans(loc_t, loc_tmp_t, {sock_file file });
manage_sock_files_pattern(loc_t, loc_tmp_t, loc_tmp_t);
manage_files_pattern(loc_t, loc_tmp_t, loc_tmp_t);
allow loc_t self:tcp_socket { accept listen };
allow loc_t unreserved_port_t:tcp_socket name_bind;
allow loc_t unreserved_port_t:udp_socket name_bind;
allow loc_t sensor_hal_daemon_tmp_t:sock_file { setattr write};
mount_copybind_file(loc_etc_t)
#Use tafSomeipGWSvc as routing manager

ifdef(`qti-nad-telaf',`
    gen_require(`
        type telaf_tafSomeipGWSvc_t;
        type telaf_someiptmp_t;
    ')
    telaf_tafSomeipGWSvc_connect(loc_t);
    telaf_tafSomeipGWSvc_write(loc_t);
    telaf_tafSomeipGWSvc_write(loc_tmp_t);
    #Allow LocIdlAPIService to export json file from /legato/ path
    telaf_read_lib_files(loc_t);
    #Rules for LocIdlAPIClient test app with APP ID 302
    files_tmp_filetrans(unconfined_t, loc_tmp_t, sock_file, "tafSomeipGWSvc-302")
    userdebug_or_eng(`
        gen_require(`
            type unconfined_t;
        ')
        allow telaf_tafSomeipGWSvc_t unconfined_t:unix_stream_socket connectto;
    ')
')

allow loc_t loc_idl_service_exec_t:file { execute execute_no_trans map open read };
access_power_mgr_socket(loc_t)

allow lowi_server_t self:netlink_socket create_socket_perms;
