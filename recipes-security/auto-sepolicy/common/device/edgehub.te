policy_module(edgehub, 1.0)

type ota_etc_conf_t;
type ota_data_conf_t;
type ota_data_certs_t;
type ota_data_log_t;

files_type(ota_etc_conf_t)
files_type(ota_data_conf_t)
files_type(ota_data_certs_t)
files_type(ota_data_log_t)

type ota_manager_exec_t;
type ota_manager_t;
files_type(ota_manager_exec_t)

type sota_manager_exec_t;
type sota_manager_t;
files_type(sota_manager_exec_t)

type smq_manager_exec_t;
type smq_manager_t;
files_type(smq_manager_exec_t)

type c2c_hub_exec_t;
type c2c_hub_t;
files_type(c2c_hub_exec_t)

type softsku_manager_exec_t;
type softsku_manager_t;
files_type(softsku_manager_exec_t)

type dm_manager_exec_t;
type dm_manager_t;
files_type(dm_manager_exec_t)

gen_require(`
    type sysfs_t;
    type default_t;
    type tmp_t;
    type ubi_device_t;
    type proc_t;
    type socket_device_t;
    type data_t;
    type etc_t;
    type net_conf_t;
    type unconfined_t;
    type fs_t;
    type qwes_license_store_setup_t;
    type mount_copybind_t;
    type mount_t;
    type init_var_run_t;
    type systemd_resolved_var_run_t;
    type unreserved_port_t;
    type urandom_device_t;
    class service { start status stop reload };
')

attribute ota_domain;

#============= mount_copybind_t ===============
allow mount_copybind_t ota_etc_conf_t:dir { open read search mounton getattr };
allow mount_copybind_t ota_etc_conf_t:file { setattr read create write relabelfrom getattr relabelto open };

allow mount_t ota_etc_conf_t:file { getattr mounton };

# ota_manager policy
init_ota_domain(ota_manager_t, ota_manager_exec_t)
allow ota_manager_t ota_data_log_t:file { open read append write create getattr };
allow ota_manager_t ota_data_conf_t:file { open read append write create getattr };
#allow ota_manager_t qwes_data_t:dir search;

# sota_manager policy
init_ota_domain(sota_manager_t, sota_manager_exec_t)
allow sota_manager_t ota_data_log_t:file { open read append write create getattr };
allow sota_manager_t ota_data_conf_t:file { open read append write create getattr };


# c2c_hub policy
init_ota_domain(c2c_hub_t, c2c_hub_exec_t)
allow c2c_hub_t ota_data_log_t:file { open read append write create getattr };
allow c2c_hub_t ota_data_conf_t:file { open read append write create getattr };

# softsku_manager policy
init_ota_domain(softsku_manager_t, softsku_manager_exec_t)

# dm policy
init_ota_domain(dm_manager_t, dm_manager_exec_t)

#smq_manager policy
init_vendor_domain(smq_manager_t, smq_manager_exec_t)
allow smq_manager_t ota_data_log_t:file { open read append write create getattr };
allow smq_manager_t ota_data_conf_t:file { open read append write create getattr };
allow smq_manager_t ota_etc_conf_t:file { open read append write create getattr };
allow smq_manager_t etc_t:file { read write mounton getattr open };
allow smq_manager_t etc_t:lnk_file read;
allow smq_manager_t init_var_run_t:dir search;
allow smq_manager_t net_conf_t:file { read getattr open };
allow smq_manager_t proc_t:file { read getattr open };
allow smq_manager_t self:netlink_route_socket { read write bind create getattr nlmsg_read };
allow smq_manager_t self:tcp_socket { write connect shutdown read getopt create };
allow smq_manager_t self:udp_socket { read write create connect getattr };
allow smq_manager_t socket_device_t:dir search;
allow smq_manager_t systemd_resolved_var_run_t:dir search;
allow smq_manager_t systemd_resolved_var_run_t:file { read getattr open };
allow smq_manager_t unreserved_port_t:tcp_socket name_connect;
allow smq_manager_t urandom_device_t:chr_file { read getattr open create};
allow smq_manager_t ota_data_conf_t:dir { open search read getattr};
allow smq_manager_t ota_etc_conf_t:file { open read append write create getattr };
allow smq_manager_t ota_etc_conf_t:dir { open search read getattr};
