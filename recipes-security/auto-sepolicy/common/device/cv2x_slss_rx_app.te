policy_module(cv2x_slss_rx_app, 1.0)

type cv2x_slss_rx_app_t;
type cv2x_slss_rx_app_exec_t;

init_vendor_domain(cv2x_slss_rx_app_t, cv2x_slss_rx_app_exec_t)

transition_to_confined_domain(cv2x_slss_rx_app_t, cv2x_slss_rx_app_exec_t)

telux_allow_v2x(cv2x_slss_rx_app_t);
