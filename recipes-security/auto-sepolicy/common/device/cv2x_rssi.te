policy_module(cv2x_rssi, 1.0)

type cv2x_rssi_t;
type cv2x_rssi_exec_t;

init_vendor_domain(cv2x_rssi_t, cv2x_rssi_exec_t)
transition_to_confined_domain(cv2x_rssi_t, cv2x_rssi_exec_t)

telux_allow_v2x(cv2x_rssi_t);
telux_allow_data(cv2x_rssi_t);

kernel_read_network_state(cv2x_rssi_t)

corenet_udp_bind_all_unreserved_ports(cv2x_rssi_t)
corenet_udp_bind_generic_node(cv2x_rssi_t)

allow cv2x_rssi_t self:udp_socket { ioctl read create connect write getopt setopt accept bind listen shutdown };

telux_allow_cv2x_flow_ops(cv2x_rssi_t)
