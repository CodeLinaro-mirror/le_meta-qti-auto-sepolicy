policy_module(cv2x-daemon, 1.0)
type cv2xd_t;
type cv2xd_exec_t;

#domain transition if started from init
init_vendor_domain(cv2xd_t, cv2xd_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(cv2xd_t, cv2xd_exec_t)

# V2x client Permissions
telux_allow_v2x(cv2xd_t)

# Power Client Permissions
telux_allow_power(cv2xd_t)

# Data Client Permissions
telux_allow_data(cv2xd_t)

gen_require(`
    type default_t;
    type init_var_run_t;
    type home_root_t;
    type user_home_dir_t;
    type etc_t;
')

# To notify systemd service about the health of the daemon
allow cv2xd_t init_var_run_t:sock_file write_file_perms;

dev_write_kmsg(cv2xd_t)
corecmd_exec_shell(cv2xd_t)
kernel_read_system_state(cv2xd_t)
logging_send_syslog_msg(cv2xd_t)
dontaudit cv2xd_t default_t:dir search;
allow cv2xd_t self:process signal;
#diag is required for qcmap/dsi logging
rw_diag_dev(cv2xd_t);
userdom_allow_fileops(cv2xd_t);
allow cv2xd_t home_root_t:dir {search getattr };
allow cv2xd_t user_home_dir_t:dir { getattr search };
read_files_pattern(cv2xd_t, etc_t, etc_t);
allow cv2xd_t self:capability { setgid };
