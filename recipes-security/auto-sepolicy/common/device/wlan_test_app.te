policy_module(wlan_test_app, 1.0)
type wlan_test_app_t;
type wlan_test_app_exec_t;

# domain transition if started from init
init_vendor_domain(wlan_test_app_t, wlan_test_app_exec_t)

# domain transition if started from adb shell
transition_to_confined_domain(wlan_test_app_t, wlan_test_app_exec_t)

gen_require(`
        type etc_t;
')

# For std::cin
userdom_read_user_ptys(wlan_test_app_t)

# Allow setting secondary groups
allow wlan_test_app_t self:capability setgid;

# Allow wlan_test_app to recive signals for generating coredumps
allow wlan_test_app_t self:process signal;

# Obtain required permissions from telux_allow_wlan
telux_allow_wlan(wlan_test_app_t)

# Obtain required permission in terms of API access control
telux_allow_wlan_device_config(wlan_test_app_t)
telux_allow_wlan_ap_config(wlan_test_app_t)
telux_allow_wlan_sta_config(wlan_test_app_t)
telux_allow_wlan_ap_devices(wlan_test_app_t)
