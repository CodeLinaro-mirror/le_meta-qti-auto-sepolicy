policy_module(tsens_service, 1.0)

type tsens_t;
type tsens_exec_t;

init_vendor_domain(tsens_t, tsens_exec_t)

gen_require(`
    type default_t;
    type thermal-engine_t;
    type firmware_t;
    type ion_device_t;
    type qseecom_device_t;
    type socket_device_t;
    type vendor_dmabuf_qseecom_heap_device_t;
    type vendor_dmabuf_qseecomta_heap_device_t;
')

dontaudit tsens_t default_t:dir search;
logging_send_syslog_msg(tsens_t);
allow tsens_t self:socket create_socket_perms;
allow tsens_t self:capability net_bind_service;
allow tsens_t thermal-engine_t:unix_stream_socket { read connectto };
firmware_search_dirs(tsens_t)
system_read_link_files(tsens_t)
userdebug_or_eng(`
    gen_require(`
        type debugfs_t;
    ')
    allow tsens_t debugfs_t:dir search;
')
allow tsens_t firmware_t:lnk_file read;
allow tsens_t firmware_t:file read_file_perms;
rw_chr_files_pattern(tsens_t, device_t, ion_device_t)
rw_chr_files_pattern(tsens_t, device_t, qseecom_device_t)
allow tsens_t self:qipcrtr_socket { create getattr read write };
allow tsens_t self:capability2 wake_alarm;
dontaudit tsens_t socket_device_t:dir search;
allow tsens_t self:process signal;
rw_smcinvoke_dev_node(tsens_t)
allow tsens_t vendor_dmabuf_qseecom_heap_device_t:chr_file { ioctl open read };
allow tsens_t vendor_dmabuf_qseecomta_heap_device_t:chr_file { ioctl open read };
