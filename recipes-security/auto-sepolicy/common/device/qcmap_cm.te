corenet_tcp_connect_all_ports(qcmap_cm_t)
userdebug_or_eng(`
  append_files_pattern(dnsmasq_t, debugfs_t, debugfs_t)
  append_files_pattern(qcmap_cm_t, debugfs_t, debugfs_t)
')

gen_require(`
  type modem_monitor_t;
  type socket_device_t;
  type default_t;
  type ipa_vlan_cfg_t;
  type system_data_t;
  type dhcpc_var_run_t;
  type qti_socksv5_se_exec_t;
  type wpa_cli_exec_t;
  type qcmap_var_run_t;
  type event_device_t;
  type dhcpc_runtime_t;
  type dnsmasq_unit_t;
  class service { start status stop reload };
  type telsdk_etc_t;
  type qms_sock_t;
  type qms_t;
')

allow qcmap_cm_t modem_monitor_t:unix_stream_socket connectto;
allow qcmap_cm_t socket_device_t:sock_file write;
allow qcmap_cm_t ipa_vlan_cfg_t:file { open read write getattr lock append };
allow qcmap_cm_t system_data_t:file { create open read write unlink };
access_power_mgr_socket(qcmap_cm_t)
allow qcmap_cm_t qti_socksv5_se_exec_t:service { start status stop };
allow qcmap_cm_t qti_socksv5_se_exec_t:file { getattr execute execute_no_trans map open read };
allow qcmap_cm_t wpa_cli_exec_t:file { map };
allow qcmap_cm_t qcmap_var_run_t:dir rw_dir_perms;
allow qcmap_cm_t dhcpc_runtime_t:dir { rw_dir_perms watch };
ifdef(`init_systemd',`
    allow qcmap_cm_t dnsmasq_unit_t:service { start status stop reload };
')
allow qcmap_cm_t telsdk_etc_t:file { read open };
allow qcmap_cm_t qms_t:unix_stream_socket connectto;
allow qcmap_cm_t qms_sock_t:sock_file write;
dontaudit qcmap_cm_t self:capability { dac_override } ;
allow qcmap_cm_t self:{ netlink_kobject_uevent_socket} create_socket_perms;
allow qcmap_cm_t qcmap_var_run_t:dir watch;

#DHCPCD Rules
files_runtime_file(dhcpc_var_run_t)
manage_sock_files_pattern(dhcpc_t, dhcpc_var_run_t, dhcpc_var_run_t)
files_runtime_filetrans(dhcpc_t, dhcpc_var_run_t, sock_file)
allow dhcpc_t self:capability { kill };
write_sock_files_pattern(dhcpc_t, systemd_logind_var_run_t, systemd_logind_var_run_t)

allow dhcpc_t default_t:dir { search read open getattr };
allow dhcpc_t default_t:file { read open execute execute_no_trans getattr };

allow qcmap_cm_t qcmap_var_run_t: dir { watch };

rw_chr_files_pattern(qcmap_cm_t, device_t, event_device_t)
mls_file_read_all_levels(qcmap_cm_t)
mls_file_write_all_levels(qcmap_cm_t)

