policy_module(fta_telsdkdata, 1.0)
type fta_telsdkdata_t;
type fta_telsdkdata_exec_t;

#domain transition if started from init
init_vendor_domain(fta_telsdkdata_t, fta_telsdkdata_exec_t)

gen_require(`
        type user_devpts_t;
        type etc_t;
        type user_home_dir_t;
')

allow fta_telsdkdata_t user_devpts_t:chr_file read;

#Allow setting secondary groups
allow fta_telsdkdata_t self:capability setgid;
allow fta_telsdkdata_t etc_t:file read_file_perms;

# Allow telsdk telephony clients
telux_allow_tel(fta_telsdkdata_t)
telux_allow_tel_card_power(fta_telsdkdata_t)
telux_allow_tel_card_ops(fta_telsdkdata_t)
telux_allow_tel_card_privileged_ops(fta_telsdkdata_t)
telux_allow_tel_sap(fta_telsdkdata_t)
telux_allow_tel_cell_broadcast_config(fta_telsdkdata_t)
telux_allow_tel_cell_broadcast_listen(fta_telsdkdata_t)
telux_allow_tel_sim_profile_ops(fta_telsdkdata_t)
telux_allow_tel_sim_profile_user_consent(fta_telsdkdata_t)
telux_allow_tel_sim_profile_config(fta_telsdkdata_t)
telux_allow_tel_sim_profile_read(fta_telsdkdata_t)
telux_allow_tel_sim_profile_http_proxy(fta_telsdkdata_t)
telux_allow_tel_remote_sim(fta_telsdkdata_t)
telux_allow_tel_sms_ops(fta_telsdkdata_t)
telux_allow_tel_sms_listen(fta_telsdkdata_t)
telux_allow_tel_sms_config(fta_telsdkdata_t)
telux_allow_tel_ims_settings(fta_telsdkdata_t)
telux_allow_tel_srv_system_config(fta_telsdkdata_t)
telux_allow_tel_srv_system_read(fta_telsdkdata_t)
telux_allow_tel_network_selection_ops(fta_telsdkdata_t)
telux_allow_tel_network_selection_read(fta_telsdkdata_t)
telux_allow_tel_multisim_mgmt(fta_telsdkdata_t)
telux_allow_tel_private_info_read(fta_telsdkdata_t)
telux_allow_tel_sub_private_info_read(fta_telsdkdata_t)
telux_allow_tel_subscription_read(fta_telsdkdata_t)
telux_allow_tel_call_info_read(fta_telsdkdata_t)
telux_allow_tel_call_mgmt(fta_telsdkdata_t)
telux_allow_tel_call_private_info(fta_telsdkdata_t)
telux_allow_tel_emergency_ops(fta_telsdkdata_t)
telux_allow_tel_ecall_mgmt(fta_telsdkdata_t)
telux_allow_tel_phone_mgmt(fta_telsdkdata_t)
telux_allow_tel_phone_config(fta_telsdkdata_t)
telux_allow_tel_ecall_config(fta_telsdkdata_t)
telux_allow_tel_supp_services(fta_telsdkdata_t)
telux_allow_data_setting(fta_telsdkdata_t)
telux_allow_data_call_ops(fta_telsdkdata_t)
telux_allow_data_call_props(fta_telsdkdata_t)
telux_allow_data_profile_ops(fta_telsdkdata_t)
telux_allow_data_filter_ops(fta_telsdkdata_t)
telux_allow_data_network_config(fta_telsdkdata_t)

# Allow telsdk data clients
telux_allow_data(fta_telsdkdata_t)

# Allow telsdk audio clients
telux_allow_audio_voice(fta_telsdkdata_t)

allow fta_telsdkdata_t self:process signal;
