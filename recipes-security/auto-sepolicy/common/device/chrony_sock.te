policy_module(chrony_sock, 1.0)
type chrony_sock_t;
type chrony_sock_exec_t;

init_vendor_domain(chrony_sock_t, chrony_sock_exec_t)

gen_require(`
    type chronyd_var_run_t;
    type chronyd_t;
')


allow chrony_sock_t chronyd_var_run_t:sock_file write;
allow chrony_sock_t self:capability { setgid };
allow chrony_sock_t self:fifo_file { ioctl };
allow chrony_sock_t self:udp_socket { create };
allow chrony_sock_t self:socket create_socket_perms;
dontaudit chrony_sock_t self:process signal;
logging_send_syslog_msg(chrony_sock_t)


allow chrony_sock_t chronyd_t:unix_dgram_socket sendto;
write_telux_log_file(chrony_sock_t);

dontaudit chrony_sock_t self:capability dac_override;
telux_allow_loc(chrony_sock_t)
telux_allow_v2x(chrony_sock_t);
telux_allow_data(chrony_sock_t);
telux_allow_qmi_client(chrony_sock_t);
telux_allow_cv2x_info(chrony_sock_t);
