policy_module(telux_audio_server, 1.0)

type telux_audio_server_t;
type telux_audio_server_exec_t;

gen_require(`
    type audio_device_t;
    type audio_hal_etc_acdb_t;
    type audio_hal_etc_t;
    type data_t;
    type default_t;
    type debugfs_t;
    type ion_device_t;
    type sound_device_t;
    type telsdk_etc_t;
')

init_vendor_domain(telux_audio_server_t, telux_audio_server_exec_t)

userdebug_or_eng(`
     rw_diag_dev(telux_audio_server_t);
     kernel_read_debugfs(telux_audio_server_t);
')

allow telux_audio_server_t audio_device_t:chr_file rw_chr_file_perms;
allow telux_audio_server_t audio_hal_etc_t:file read_file_perms;
allow telux_audio_server_t audio_hal_etc_acdb_t:dir list_dir_perms;
allow telux_audio_server_t audio_hal_etc_acdb_t:file { read getattr open };
allow telux_audio_server_t audio_device_t:chr_file rw_chr_file_perms;
allow telux_audio_server_t ion_device_t:chr_file read_chr_file_perms;
allow telux_audio_server_t sound_device_t:chr_file rw_chr_file_perms;
dontaudit telux_audio_server_t default_t:dir search;
dontaudit telux_audio_server_t data_t:dir search;
allow telux_audio_server_t self:capability net_bind_service;
allow telux_audio_server_t self:socket create_socket_perms;
device_search_sockets(telux_audio_server_t);
dev_read_sysfs(telux_audio_server_t);
allow telux_audio_server_t telsdk_etc_t:file { read write open };
kernel_read_system_state(telux_audio_server_t)
logging_send_syslog_msg(telux_audio_server_t);
