policy_module(compensator, 1.0)

type compensator_t;
type compensator_exec_t;
type compensator_etc_t;
type compensator_var_run_t;

files_type(compensator_etc_t);

init_vendor_domain(compensator_t, compensator_exec_t)
transition_to_confined_domain(compensator_t, compensator_exec_t)

gen_require(`
    type var_run_t;
    type compensator_etc_t;
    type shell_exec_t;
    type proc_t;
    type sysfs_t;
    type tty_device_t;
    type systemd_tmpfiles_t;
    type gpiochip_device_t;
')

allow compensator_t compensator_etc_t:file read_file_perms;
allow compensator_t self:process {signal};

systemd_tmpfilesd_managed(compensator_var_run_t, file)
allow systemd_tmpfiles_t compensator_var_run_t:file { getattr open write };

files_pid_file(compensator_var_run_t)
files_pid_filetrans(compensator_t, compensator_var_run_t, { file dir })
manage_files_pattern(compensator_t, var_run_t, compensator_var_run_t);

telux_allow_v2x(compensator_t)
telux_allow_cv2x_info(compensator_t)
telux_allow_data(compensator_t)
allow compensator_t shell_exec_t:file { execute read open execute_no_trans };
allow compensator_t proc_t:file { read write open getattr };
allow compensator_t sysfs_t:file { read open write };
allow compensator_t tty_device_t:chr_file manage_chr_file_perms;

allow compensator_t self:capability { setgid };
allow compensator_t self:udp_socket { create ioctl };

allow compensator_t gpiochip_device_t:chr_file read_file_perms;
