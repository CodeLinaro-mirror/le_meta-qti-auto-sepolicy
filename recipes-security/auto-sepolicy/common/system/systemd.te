userdebug_or_eng(`
    gen_require(`
        type debugfs_t;
        type sysfs_power_state_t;
    ')
     allow systemd_tmpfiles_t debugfs_t:filesystem getattr;
')

gen_require(`
    type telsdk_data_t;
    type boot_kpi_values_t;
    type cpu_online_t;
    type gptp_socket_t;
    type kernel_t;
    type etc_t;
    type loc_socket_t;
')
allow systemd_tmpfiles_t telsdk_data_t:file relabelfrom;
dontaudit systemd_tmpfiles_t boot_kpi_values_t:file relabelfrom;
allow systemd_tmpfiles_t cpu_online_t:file setattr;
allow systemd_tmpfiles_t gptp_socket_t:dir { create read open getattr setattr relabelfrom relabelto};
allow systemd_tmpfiles_t sysfs_power_state_t:file { getattr setattr relabelfrom relabelto};
dontaudit systemd_tmpfiles_t tmp_t:lnk_file relabelfrom;
dontaudit systemd_tmpfiles_t var_log_t:lnk_file relabelfrom;
dontaudit kernel_t etc_t:dir { create };
allow systemd_tmpfiles_t loc_socket_t:sock_file getattr;
