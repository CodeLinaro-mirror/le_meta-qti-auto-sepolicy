gen_require(`
	type mount_copybind_t;
	type var_t;
	type var_lib_t;
	type var_spool_t;
	type etc_t;
	type kernel_t;
	type cv2xd_etc_t;
	type ipa_vlan_cfg_t;
	type power_manager_conf_t;
	type qits_etc_t;
	type sensor_util_t;
	type telsdk_etc_t;
	type fixed_disk_device_t;
        type audio_hal_etc_t;
        type loc_etc_t;
        type throttleman_etc_t;
')

dontaudit mount_copybind_t self:capability sys_admin;

allow mount_copybind_t var_lib_t:dir { getattr search };
allow mount_copybind_t var_spool_t:dir { getattr search };
allow mount_copybind_t var_t:dir { write add_name create };

allow mount_t var_spool_t:dir mounton;
allow mount_t var_t:dir { manage_dir_perms mounton };
dontaudit mount_t etc_t:file map;
dontaudit mount_t kernel_t:process setsched;
dontaudit unconfined_mount_t kernel_t:process setsched;

dontaudit mount_copybind_t cv2xd_etc_t:file ioctl;
dontaudit mount_copybind_t ipa_vlan_cfg_t:file ioctl;
dontaudit mount_copybind_t power_manager_conf_t:file ioctl;
dontaudit mount_copybind_t qits_etc_t:file ioctl;
dontaudit mount_copybind_t sensor_util_t:file ioctl;
dontaudit mount_copybind_t telsdk_etc_t:file ioctl;
dontaudit unconfined_mount_t fixed_disk_device_t:blk_file getattr;
dontaudit mount_copybind_t audio_hal_etc_t:file ioctl;
dontaudit mount_copybind_t loc_etc_t:file ioctl;
dontaudit mount_copybind_t throttleman_etc_t:file ioctl;
