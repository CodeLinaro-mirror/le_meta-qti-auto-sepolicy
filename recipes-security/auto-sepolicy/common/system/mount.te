gen_require(`
	type mount_copybind_t;
	type var_t;
	type var_lib_t;
	type var_spool_t;
	type etc_t;
	type kernel_t;
	type fixed_disk_device_t;
	type setfiles_t;
	type usb_dev_t;
	type usbfs_t;
')

dontaudit mount_copybind_t self:capability sys_admin;

allow mount_copybind_t var_lib_t:dir { getattr search };
allow mount_copybind_t var_spool_t:dir { getattr search };
allow mount_copybind_t var_t:dir { write add_name create };

allow mount_t var_spool_t:dir mounton;
allow mount_t var_t:dir { manage_dir_perms mounton };
dontaudit mount_t etc_t:file { map };
dontaudit mount_t kernel_t:process setsched;
dontaudit unconfined_mount_t kernel_t:process setsched;
dontaudit unconfined_mount_t fixed_disk_device_t:blk_file getattr;
allow setfiles_t usb_dev_t:dir search;
allow setfiles_t usbfs_t:filesystem getattr;
