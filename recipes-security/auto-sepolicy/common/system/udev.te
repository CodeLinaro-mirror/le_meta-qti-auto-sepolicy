gen_require(`
    type sysdevice_sysfs_t;
    type cpu_sysfs_t;
    type sysfs_t;
    type tmp_t;
    type qcmap_tmp_t;
    type tuicoreservice_dev_t;
    type sdcard_t;
    type sysdevice_sysfs_t;
')

# /lib/systemd/systemd-udevd is invoking
# automountsdcard.sh script from /etc/udev/script/.
# The script is reading /sys/devices/soc0/machine`
# Adding dontaudit rule for suppress the denial
dontaudit udev_t sysdevice_sysfs_t:file { open read };
allow udev_t cpu_sysfs_t:file write;
allow udev_t sysfs_t:dir setattr;
allow udev_t sysfs_t:file setattr;
allow udev_t tmp_t:dir search;
allow udev_t sysfs_t:lnk_file setattr;
allow udev_t qcmap_tmp_t:dir { write search add_name };
allow udev_t qcmap_tmp_t:lnk_file create;
allow udev_t tuicoreservice_dev_t:chr_file setattr;
allow udev_t sdcard_t:dir getattr;
dontaudit udev_t init_runtime_t:file { open read };
