userdebug_or_eng(`
    gen_require(`
        type ks_exec_t;
        type rebootd_pipe_t;
        type usb_dev_t;
        type recovery_exec_t;
        type cpu_scaling_freq_t;
        type snd_card_state_t;
        type sysfs_cpu_present;
        type kernel_t;
        type webserver_t;
        type stream_update_engine_t;
    ')

    can_exec(unconfined_t, ks_exec_t);
    allow unconfined_t rebootd_pipe_t:fifo_file getattr;
    allow unconfined_t usb_dev_t:dir getattr;
    files_type(recovery_exec_t)
    mls_file_read_all_levels(unconfined_t)
    allow unconfined_t cpu_scaling_freq_t:file { write getattr open read};
    allow unconfined_t self:bpf map_create;
    allow unconfined_t self:bpf { map_create map_read map_write prog_load prog_run };
    allow unconfined_t self:cap_userns { sys_admin sys_ptrace };
    allow unconfined_t self:cap_userns { net_admin net_raw sys_admin };
    allow unconfined_t sysfs_cpu_present:file getattr;
    allow unconfined_t kernel_t:process getpgid;
    type alsaucm_test_t;
    user_data_files_type(alsaucm_test_t)
    data_filetrans(unconfined_t, alsaucm_test_t, { fifo_file })
    allow unconfined_t alsaucm_test_t:fifo_file { create open read write getattr unlink execute };
    allow unconfined_t self:binder { call transfer };
    allow unconfined_t snd_card_state_t:file { getattr open read };
    allow unconfined_t self:bpf map_create;
    allow unconfined_t self:bpf { map_create map_read map_write prog_load prog_run };
    #allow unconfined_t self:cap_userns { sys_admin sys_ptrace };
    #allow unconfined_t self:cap_userns { net_admin net_raw sys_admin };
    allow unconfined_t sysfs_cpu_present:file getattr;
    allow unconfined_t kernel_t:process getpgid;
    allow unconfined_t webserver_t:dir getattr;
    allow unconfined_t stream_update_engine_t:binder call;
    allow unconfined_t stream_update_engine_t:binder transfer;
')
