policy_module(mvm_test_app, 1.0)
type mvm_test_app_t;
type mvm_test_app_exec_t;

#domain transition if started from init
init_vendor_domain(mvm_test_app_t, mvm_test_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(mvm_test_app_t, mvm_test_app_exec_t)

allow_mvm_lib(mvm_test_app_t)
dontaudit mvm_test_app_t self:process signal;
allow_mvm_stats_lib(mvm_test_app_t)
allow mvm_test_app_t self:capability setgid;
